    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@octokit/rest": "^22.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.6.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@playwright/test": "1.64.1",
