{
  "name": "witl-xyz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile:blog": "bun scripts/compile-blog.ts",
    "dev": "bun scripts/dev.ts",
    "build": "next build",
    "prebuild": "bun run compile:blog",
    "start": "next start",
    "lint": "eslint src",
    "deploy": "bun run build:worker && wrangler deploy",
    "preview": "opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "build:worker": "bun run compile:blog && opennextjs-cloudflare build",
    "check:worker": "wrangler deploy --dry-run",
    "dev:worker": "wrangler dev --port 8771",
    "preview:worker": "bun run build:worker && bun run dev:worker",
    "deploy:worker": "bun run deploy",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "format": "prettier --write '**/*.{js,jsx,ts,tsx,json,md,yml}'",
    "format:check": "prettier --check '**/*.{js,jsx,ts,tsx,json,md,yml}'",
    "postinstall": "patch-package"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
