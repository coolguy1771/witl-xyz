{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "witl-xyz",
  "main": "worker.ts",
  "compatibility_date": "2026-05-30",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "destinations": ["grafana-traces"]
    },
    "traces": {
      "enabled": true,
      "destinations": ["witl-xyz-grafana-traces"]
    }
  },
  "vars": {
    "ENVIRONMENT": "production",
    "NODE_ENV": "production",
    "LOG_LEVEL": "info",
    "RATE_LIMIT_WINDOW": "60",
    "RATE_LIMIT_MAX_REQUESTS": "20"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "witl-xyz"
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "witl_xyz"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "witl-xyz-cache"
    },
    {
      "binding": "MEDIA",
      "bucket_name": "witl-xyz-media"
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  }
}
